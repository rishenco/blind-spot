{
  "name": "blind-spot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shots": "npm run build && node tools/shoot.mjs",
    "quiet": "npm run build && node tools/quiet.mjs",
    "shots:spiders": "npm run build && node tools/spiders.mjs",
    "shots:hud": "npm run build && node tools/hud.mjs",
    "shots:hands": "npm run build && node tools/hands.mjs",
    "shots:audio": "npm run build && node tools/audio.mjs",
    "shots:concussion": "npm run build && node tools/concussion.mjs",
    "shots:world": "npm run build && node tools/world.mjs",
    "shots:radio": "npm run build && node tools/radio.mjs",
    "shots:sound-pulse": "npm run build && node tools/sound-pulse.mjs",
    "check:gate": "npm run build && node tools/gate.mjs",
    "check:spider-attention": "npm run build && node tools/check-spider-attention.mjs",
    "check:sound-perception": "npm run build && node tools/check-sound-perception.mjs",
    "check:sound-pulse": "node tools/check-sound-pulse.mjs",
    "check:spawn-lidar": "npm run build && node tools/check-spawn-lidar.mjs",
    "check:prop-touch": "node tools/check-prop-touch.mjs",
    "check:finale": "npm run build && node tools/check-finale.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "lil-gui": "^0.21.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
